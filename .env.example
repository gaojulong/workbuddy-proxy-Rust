# ============================================================
# WorkBuddy Proxy 配置模板
# 使用方式：复制本文件为 .env 后按需修改
#   cp .env.example .env
# ============================================================

# ========== 必填项（不填则使用默认值） ==========

# 代理监听端口（客户端连接的端口）
PROXY_PORT=19090

# 客户端使用的 API Key（自定义，用于保护代理接口）
# 客户端请求时需要带: Authorization: Bearer <此值>
# 改成一个只有你知道的字符串即可
PROXY_API_KEY=wb-proxy-key

# ========== 通常不用改 ==========

# WorkBuddy API 地址（上游，一般保持不变）
# WB_API_BASE=https://copilot.tencent.com

# CDP 调试地址（用于自动提取 Token，需本机运行 WorkBuddy 且开启调试端口）
# CDP_URL=http://127.0.0.1:9222

# 上游请求超时（秒）
# WB_TIMEOUT=120              # 普通模型（默认 120s）
# WB_REASONING_TIMEOUT=300    # 推理模型如 deepseek-r1（默认 300s）

# ========== 可选：手动指定 Token（一般不需要） ==========
# 正常情况下无需设置，程序会自动按以下顺序获取 token：
#   1. 环境变量 WB_TOKEN
#   2. data/token.json（上次保存的 token 缓存）
#   3. 通过 CDP 从本机 WorkBuddy 自动提取
# 仅当自动提取失败时，才需要手动设置：
# WB_TOKEN=<your-jwt-access-token>
# WB_REFRESH_TOKEN=<your-refresh-token>
# WB_USER_ID=<auto-detected>
# WB_ENTERPRISE_ID=<auto-detected>
# WB_DOMAIN=<auto-detected>
